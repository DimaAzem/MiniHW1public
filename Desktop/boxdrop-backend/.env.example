# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Read by both the FastAPI backend (via docker-compose) and app.py (frontend).

# Base URL of the BoxDrop backend API (include the /api prefix).
BACKEND_API_URL=http://localhost:8000/api

# Signs JWT session tokens (backend/services/auth_service.py).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left blank, a hardcoded dev-only fallback is used - fine for a quick
# local test, but set this for anything beyond that.
JWT_SECRET_KEY=
